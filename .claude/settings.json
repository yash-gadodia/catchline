{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty' 2>/dev/null); case \"$f\" in *.env.example|*.env.sample|*.env.template|*.env.dist) exit 0;; *.env|*.env.*|*.pem|*.key|*.p8|*.cert|*.crt|*.p12|*.pfx|*/credentials|*/credentials.json|*/.netrc) echo \"🚫 Blocked write to secret/credential file: $f\" >&2; exit 2;; esac; exit 0"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/pre-edit-hook.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/post-edit-hook.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/scripts/stop-hook.sh\""
          }
        ]
      }
    ]
  }
}
