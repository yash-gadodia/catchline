#!/usr/bin/env sh
# A commit made from a Claude Code session carries a `Claude-Session: <name> (<session id>)`
# trailer, so whoever pushes can tell which session owns each commit riding along and message it
# Every commit's author is the same human, so nothing else in git says which
# session wrote it. The name is what SendMessage addresses; the id is stable if the session is
# renamed, and ~/.claude/sessions/<pid>.json maps one to the other.
[ -n "$CLAUDE_CODE_SESSION_ID" ] || exit 0

# A rebase or cherry-pick replays commits other sessions wrote: leave their attribution alone.
for state in rebase-merge rebase-apply CHERRY_PICK_HEAD; do
  [ -e "$(git rev-parse --git-path "$state")" ] && exit 0
done

name=""
registry="$HOME/.claude/sessions/$CLAUDE_PID.json"
[ -n "$CLAUDE_PID" ] && [ -r "$registry" ] &&
  name=$(sed -n 's/.*"name": *"\([^"]*\)".*/\1/p' "$registry" | head -n 1)

git interpret-trailers --in-place --if-exists doNothing \
  --trailer "Claude-Session: ${name:-unnamed} ($CLAUDE_CODE_SESSION_ID)" "$1"
